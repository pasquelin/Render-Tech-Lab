{
  "name": "render-tech-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Real-time rendering R&D lab for WebGPU / Three.js TSL \u2014 isolated modules, reproducible benchmarks, measured gain/cost decisions.",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:math && node --experimental-strip-types test/run_all_tests.ts && node --experimental-strip-types --test test/*.test.ts && npm run test:nested && npm run test:structure",
    "test:math": "node --experimental-strip-types shared/math/screenSpaceError.test.ts && node --experimental-strip-types shared/math/oracles.test.ts",
    "bench": "npm run build && node --experimental-strip-types bench/run.mjs",
    "bench:all": "npm run build && node --experimental-strip-types bench/run.mjs",
    "bench:00": "npm run build && node --experimental-strip-types bench/run.mjs --test=00-baseline",
    "bench:01": "npm run build && node --experimental-strip-types bench/run.mjs --test=01-indirect-draw",
    "bench:02": "npm run build && node --experimental-strip-types bench/run.mjs --test=02-gpu-frustum-culling",
    "bench:03": "npm run build && node bench/run.mjs --test=03-gpu-scene",
    "bench:04": "node --experimental-strip-types 04-gpu-lod/tests/test_lod.ts",
    "bench:05": "npm run build && node --experimental-strip-types bench/run.mjs --test=05-meshlets",
    "bench:06": "npm run build && node --experimental-strip-types bench/run_cpu_oracle.mjs --test=06-meshlet-culling",
    "bench:07": "npm run build && node --experimental-strip-types bench/run_cpu_oracle.mjs --test=07-hiz",
    "bench:08": "npm run build && node --experimental-strip-types bench/run.mjs --test=08-occlusion-culling",
    "bench:09": "npm run build && node --experimental-strip-types bench/run.mjs --test=09-gpu-compaction",
    "bench:10": "npm run build && node --experimental-strip-types bench/run.mjs --test=10-material-batching",
    "bench:11": "npm run build && node --experimental-strip-types bench/run.mjs --test=11-geometry-streaming",
    "bench:12": "npm run build && node --experimental-strip-types bench/run.mjs --test=12-visibility-buffer",
    "bench:13": "npm run build && node --experimental-strip-types bench/run.mjs --test=13-full-gpu-driven",
    "test:nested": "node --experimental-strip-types --test 10-material-batching/tests/materialBatching.test.ts 11-geometry-streaming/tests/streamingManager.test.ts 12-visibility-buffer/tests/visibilityBuffer.test.ts",
    "test:unit": "npm run test:math && node --experimental-strip-types test/run_all_tests.ts && node --experimental-strip-types --test test/*.test.ts && npm run test:nested",
    "test:webgpu": "npm run build && node bench/run.mjs --smoke",
    "validate": "npm test && npm run test:integration && npm run test:comparison && npm run build",
    "test:comparison": "node --experimental-strip-types 04-gpu-lod/tests/variants.test.ts && node --experimental-strip-types --test benchmarks/lodComparisonPlugin.test.ts && npm run test:world",
    "test:integration": "node --experimental-strip-types --test 15-virtualized-integration/tests/*.test.ts",
    "bench:15": "npm run build && node bench/run_integration.mjs",
    "test:world": "node --experimental-strip-types --test 14-open-world/tests/*.test.ts",
    "test:structure": "node --experimental-strip-types --test [01][0-9]-*/tests/contract.test.ts [01][0-9]-*/tests/structure.test.ts test/labArchitecture.test.ts",
    "prepare:models": "node --experimental-strip-types 15-virtualized-integration/assets/prepare-models.ts"
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "meshoptimizer": "^0.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.174.0"
  },
  "optionalDependencies": {
    "@web-geometry/sdk": "link:../webGeometry"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@webgpu/types": "^0.1.72",
    "daisyui": "^5.7.34",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  },
  "packageManager": "pnpm@12.4.1"
}
