{
  "name": "render-tech-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Real-time rendering R&D lab for WebGPU / Three.js TSL — isolated modules, reproducible benchmarks, measured gain/cost decisions.",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types shared/math/screenSpaceError.test.ts && node --experimental-strip-types shared/math/oracles.test.ts && node --experimental-strip-types test/run_all_tests.ts",
    "test:math": "node --experimental-strip-types shared/math/screenSpaceError.test.ts && node --experimental-strip-types shared/math/oracles.test.ts",
    "bench": "node --experimental-strip-types 01-indirect-draw/benchmark/test_crossover.ts",
    "bench:all": "node --experimental-strip-types test/run_all_tests.ts",
    "bench:00": "node --experimental-strip-types 00-baseline/benchmark/test_baseline.ts",
    "bench:01": "node --experimental-strip-types 01-indirect-draw/benchmark/test_crossover.ts",
    "bench:02": "node --experimental-strip-types 02-gpu-frustum-culling/benchmark/test_culling.ts",
    "bench:03": "node --experimental-strip-types 03-gpu-scene/benchmark/test_scene.ts",
    "bench:04": "node --experimental-strip-types 04-gpu-lod/benchmark/test_lod.ts",
    "bench:05": "node --experimental-strip-types 05-meshlets/benchmark/test_meshlets.ts",
    "bench:06": "node --experimental-strip-types 06-meshlet-culling/benchmark/test_meshlet_culling.ts",
    "bench:07": "node --experimental-strip-types 07-hiz/benchmark/test_hiz.ts",
    "bench:08": "node --experimental-strip-types 08-occlusion-culling/benchmark/test_occlusion.ts",
    "bench:09": "node --experimental-strip-types 09-gpu-compaction/benchmark/test_compaction.ts",
    "bench:10": "node --experimental-strip-types 10-material-batching/benchmark/test_material_batching.ts",
    "bench:11": "node --experimental-strip-types 11-geometry-streaming/benchmark/test_streaming.ts",
    "bench:12": "node --experimental-strip-types 12-visibility-buffer/benchmark/test_visibility_buffer.ts",
    "bench:13": "node --experimental-strip-types 13-full-gpu-driven/benchmark/test_full_pipeline.ts"
  },
  "dependencies": {
    "lucide": "^1.44.0",
    "meshoptimizer": "^0.22.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/three": "^0.174.0",
    "@webgpu/types": "^0.1.72",
    "autoprefixer": "^10.5.6",
    "daisyui": "^5.7.34",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
